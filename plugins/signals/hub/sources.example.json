{
  "hub": "https://<your-signals-hub-app-url>",
  "sources": [
    {
      "name": "google_calendar",
      "kind": "mcp",
      "tool": "calendar_event_list",
      "args": { "time_min": "{now}", "time_max": "{now+7d}", "max_results": 50, "query": "" },
      "items": "items",
      "detail": { "tool": "calendar_event_get", "args": { "event_id": "{id}" }, "max": 50 },
      "map": {
        "external_id": "id",
        "title": "summary",
        "url": "htmlLink",
        "occurred_at": "{start.dateTime}{start.date}",
        "payload": ["start", "end", "status", "attendeeCount", "attendees", "organizer", "description", "location", "hangoutLink", "recurringEventId"]
      }
    },
    {
      "name": "gmail",
      "kind": "mcp",
      "tool": "gmail_search",
      "args": { "query": "in:inbox after:{since_epoch}", "max_results": 50 },
      "items": "items",
      "lookback_hours": 24,
      "map": {
        "external_id": "id",
        "title": "subject",
        "actor": "from",
        "group_key": "threadId",
        "url": "https://mail.google.com/mail/u/0/#all/{threadId}",
        "occurred_at": "date",
        "payload": ["from", "to", "snippet", "labelIds"]
      }
    },
    {
      "name": "google_drive",
      "kind": "mcp",
      "tool": "google_drive_list_recent",
      "args": { "days": 1, "max_results": 50 },
      "items": "items",
      "map": {
        "external_id": "{id}:{modifiedTime}",
        "group_key": "id",
        "title": "name",
        "url": "webViewLink",
        "occurred_at": "modifiedTime",
        "payload": ["mimeType", "modifiedTime"]
      }
    },
    {
      "name": "slack",
      "kind": "mcp",
      "tool": "slack_search_public_and_private",
      "args": { "keywords": ["<@YOUR_SLACK_USER_ID>"], "filters": "", "natural_language_query": "", "after": "{since_epoch}", "limit": 20, "include_bots": false },
      "items": "results",
      "sections": {
        "split": "^### Result \\d+ of \\d+\\s*$",
        "keys": ["Channel", "Participants", "From", "Time", "Message_ts", "Reply count", "Permalink", "Text", "Context before", "Context after"]
      },
      "lookback_hours": 24,
      "map": {
        "external_id": { "from": "permalink", "match": "\\((https://[^)?]+)" },
        "url": { "from": "permalink", "match": "\\((https://[^)]+)\\)" },
        "group_key": { "from": "permalink", "match": "thread_ts=(\\d{10})|/p(\\d{10})" },
        "title": { "from": "text", "match": "^\\s*([^\\n]{1,140})" },
        "actor": { "from": "from", "match": "<([^>\\s]+@[^>\\s]+)>" },
        "occurred_at": "message_ts",
        "payload": {
          "channel": { "from": "channel", "match": "^(.*?)\\s*\\(ID:" },
          "channel_id": { "from": "channel", "match": "\\(ID: ([A-Z0-9]+)\\)" },
          "from": { "from": "from", "match": "^(.*?)\\s*\\(ID:" },
          "text": "text",
          "context_before": "context_before"
        }
      }
    },
    {
      "name": "jira",
      "kind": "mcp",
      "service": "atlassian",
      "tool": "searchJiraIssuesUsingJql",
      "args": { "jql": "(assignee = currentUser() OR reporter = currentUser() OR watcher = currentUser()) AND updated >= \"{since_date}\" ORDER BY updated DESC", "maxResults": 50, "fields": ["summary", "status", "updated", "priority", "assignee"] },
      "items": "issues",
      "lookback_hours": 48,
      "map": {
        "external_id": "key",
        "group_key": "key",
        "title": "{key} {fields.summary}",
        "occurred_at": "fields.updated",
        "payload": { "status": "{fields.status.name}", "priority": "{fields.priority.name}", "assignee": "{fields.assignee.displayName}" }
      }
    },
    {
      "name": "table.support_cases",
      "kind": "table",
      "table": "main.support.cases",
      "query": "SELECT case_id, subject, status, account_name, updated_at FROM main.support.cases WHERE updated_at > :since ORDER BY updated_at LIMIT 1000",
      "watermark": "updated_at",
      "map": {
        "external_id": "case_id",
        "group_key": "case_id",
        "title": "{case_id} {subject}",
        "account": "account_name",
        "occurred_at": "updated_at",
        "payload": ["status", "subject"]
      }
    }
  ]
}
